        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="wait-absolute-start" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
long start = Long.parseLong(vars.get("startEpochMs") ?: "0");
if (start &gt; 0) {
  long now = System.currentTimeMillis();
  if (now &lt; start) {
    Thread.sleep(start - now);
  }
}
          </stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="start-barrier" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicLong

def enabledRaw = vars.get("barrierEnabled") ?: props.get("barrierEnabled") ?: "false"
if (!"true".equalsIgnoreCase(enabledRaw?.toString()?.trim())) {
  return
}

int groupSize = Integer.parseInt((vars.get("barrierGroupSize") ?: props.get("barrierGroupSize") ?: "0").toString())
if (groupSize <= 0) {
  groupSize = Integer.parseInt((props.get("threads") ?: "1").toString())
}
long timeoutMs = Long.parseLong((vars.get("barrierTimeoutMs") ?: props.get("barrierTimeoutMs") ?: "120000").toString())
String outPath = (vars.get("barrierStatsPath") ?: props.get("barrierStatsPath") ?: "").toString().trim()

synchronized (props) {
  if (props.get("__startBarrierLock") == null) {
    props.put("__startBarrierLock", new Object())
    props.put("__startBarrierArrived", new AtomicInteger(0))
    props.put("__startBarrierReleasedAt", new AtomicLong(0))
    props.put("__startBarrierReadyCount", new AtomicInteger(0))
  }
}
def lock = props.get("__startBarrierLock")
def arrived = (AtomicInteger) props.get("__startBarrierArrived")
def releasedAt = (AtomicLong) props.get("__startBarrierReleasedAt")
def readyCount = (AtomicInteger) props.get("__startBarrierReadyCount")

int my = arrived.incrementAndGet()
long deadline = System.currentTimeMillis() + Math.max(1L, timeoutMs)
synchronized (lock) {
  while (arrived.get() < groupSize && System.currentTimeMillis() < deadline && releasedAt.get() == 0L) {
    long waitMs = Math.min(250L, Math.max(1L, deadline - System.currentTimeMillis()))
    lock.wait(waitMs)
  }
  if (releasedAt.compareAndSet(0L, System.currentTimeMillis())) {
    readyCount.set(arrived.get())
    boolean timedOut = readyCount.get() < groupSize
    if (outPath) {
      def f = new File(outPath)
      if (f.parentFile != null) { f.parentFile.mkdirs() }
      f.setText('{"readyCount":' + readyCount.get() +
        ',"configuredGroupSize":' + groupSize +
        ',"releaseEpochMs":' + releasedAt.get() +
        ',"timedOut":' + timedOut +
        ',"firstArrivedSeen":' + my +
        ',"jmeterPid":' + ProcessHandle.current().pid() +
        ',"groovyIndy":"' + System.getProperty('groovy.target.indy','false') + '"' +
        ',"javaVersion":"' + System.getProperty('java.version') + '"' +
        ',"maxHeapBytes":' + Runtime.runtime.maxMemory() +
        ',"availableProcessors":' + Runtime.runtime.availableProcessors() +
        '}\n', 'UTF-8')
    }
    lock.notifyAll()
  } else {
    while (releasedAt.get() == 0L) {
      lock.wait(50L)
    }
  }
}
vars.put("barrierReadyCount", String.valueOf(readyCount.get()))
vars.put("barrierReleaseEpochMs", String.valueOf(releasedAt.get()))
]]></stringProp>
        </JSR223PreProcessor>
