            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="eff-client-key" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def mode = props.get(&quot;clientKeyMode&quot;)
if (&quot;unique&quot;.equals(mode)) {
  vars.put(&quot;effClientKey&quot;, java.util.UUID.randomUUID().toString().replace(&quot;-&quot;, &quot;&quot;))
} else {
  def ck = vars.get(&quot;clientKey&quot;)
  vars.put(&quot;effClientKey&quot;, ck == null ? &quot;&quot; : ck)
}
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="purchase-start-rate" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script"><![CDATA[
long rate = Long.parseLong(props.getProperty('purchaseStartsPerSecond', '0'))
if (rate <= 0L) return 0L
// Leave a small scheduling margin between timer permits and actual JTL start times.
long interval = (long) Math.ceil(1_040_000_000d / rate)
def permit
synchronized (props) {
  permit = props.get('purchaseRatePermit')
  if (permit == null) {
    permit = new java.util.concurrent.atomic.AtomicLong(Long.MIN_VALUE)
    props.put('purchaseRatePermit', permit)
  }
}
long coldWaitLimit = System.nanoTime() +
  java.util.concurrent.TimeUnit.MILLISECONDS.toNanos(Long.parseLong(props.getProperty('timeoutMs', '30000')) + 5000L)
while (true) {
  long now = System.nanoTime()
  long next = permit.get()
  // Let the first real sampler finish initializing the HTTP client before
  // giving another thread a permit. The first request is still counted.
  if (next == Long.MIN_VALUE) {
    if (permit.compareAndSet(next, Long.MAX_VALUE)) return 0L
    continue
  }
  if (next == Long.MAX_VALUE) {
    if (now >= coldWaitLimit) {
      log.error('Cold purchase sampler did not release its rate permit')
      ctx.getEngine().stopTest(true)
      throw new IllegalStateException('Cold purchase sampler did not release its rate permit')
    }
    Thread.sleep(25L)
    continue
  }
  if (now >= next && permit.compareAndSet(next, now + interval)) return 0L
  long remaining = next - now
  if (remaining > 0L) java.util.concurrent.TimeUnit.NANOSECONDS.sleep(Math.min(remaining, 50_000_000L))
}
]]></stringProp>
            </JSR223Timer>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="release-cold-purchase-permit" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script"><![CDATA[
long rate = Long.parseLong(props.getProperty('purchaseStartsPerSecond', '0'))
if (rate > 0L) {
  long interval = (long) Math.ceil(1_040_000_000d / rate)
  props.get('purchaseRatePermit')?.compareAndSet(Long.MAX_VALUE, System.nanoTime() + interval)
}
]]></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="capture-business-code" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp>
<stringProp name="script"><![CDATA[
vars.put('businessCode','')
try { def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()); def code = body.code; if (code instanceof String && code ==~ /[A-Z][A-Z0-9_]{0,79}/) vars.put('businessCode',code) } catch (Exception ignored) {}
]]></stringProp></JSR223PostProcessor><hashTree/>
