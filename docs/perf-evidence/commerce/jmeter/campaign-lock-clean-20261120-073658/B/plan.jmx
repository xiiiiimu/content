<?xml version='1.0' encoding='UTF-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan testname="V23 paced measurement" testclass="TestPlan" enabled="true" guiclass="TestPlanGui">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup testclass="ThreadGroup" testname="v23-workers" enabled="true" guiclass="ThreadGroupGui">
        <stringProp name="ThreadGroup.num_threads">${__P(workers,128)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <WhileController testclass="WhileController" testname="until slots exhausted" enabled="true" guiclass="WhileControllerGui">
          <stringProp name="WhileController.condition">${__groovy(vars.get("continue") != "false")}</stringProp>
        </WhileController>
        <hashTree>
          <JSR223Sampler testclass="JSR223Sampler" testname="prepare (ignored)" enabled="true" guiclass="TestBeanGUI">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename">E:/content/infra/jmeter/v23-prepare.groovy</stringProp>
          </JSR223Sampler>
          <hashTree />
          <IfController testclass="IfController" testname="HTTP slot exists" enabled="true" guiclass="IfControllerPanel">
            <stringProp name="IfController.condition">${runHttp}</stringProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="${phaseLabel}" enabled="true">
              <stringProp name="HTTPSampler.path">${__P(apiBase,http://127.0.0.1:28080)}/api/sale-campaigns/${campaign}/purchase</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{"clientKey":"${effClientKey}"}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
              <stringProp name="HTTPSampler.connect_timeout">30000</stringProp>
              <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
              <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager testclass="HeaderManager" testname="authorized JSON" enabled="true" guiclass="HeaderPanel">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Authorization</stringProp>
                    <stringProp name="Header.value">Bearer ${token}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree />
              <JSR223PostProcessor testclass="JSR223PostProcessor" testname="safe response correlation" enabled="true" guiclass="TestBeanGUI">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename">E:/content/infra/jmeter/v23-response.groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree />
            </hashTree>
          </hashTree>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>